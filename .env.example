# Copy this file to .env and paste your key from https://aistudio.google.com/apikey
# Never share the key or commit .env
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=paste-your-key-here

# Optional: read one Gmail label. Needs 2-step verification and a Google app password.
ERASMUS_EMAIL=your-address@gmail.com
ERASMUS_APP_PASSWORD=your-app-password
ERASMUS_LABEL=Erasmus-Demo
# Optional: for a mailbox that isn't Gmail, its IMAP server.
# ERASMUS_IMAP_HOST=imap.example.org
